root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

# Spring Initializr genera el pom con tabuladores
[pom.xml]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
